# =============================================================================
#  APP
# =============================================================================
NODE_ENV=development
APP_NAME=nestjs-base
PORT=3000
API_PREFIX=api
API_DEFAULT_VERSION=1
# Danh sách origin, phân tách bằng dấu phẩy. "*" = cho phép tất cả (chỉ nên dùng ở dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
REQUEST_TIMEOUT_MS=30000
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# en | vi
FALLBACK_LANGUAGE=en
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# =============================================================================
#  DATABASE — PostgreSQL (ACTIVE)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_base
DB_SCHEMA=public
DB_SSL=false
# KHÔNG bật synchronize ở production — dùng migrations
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=true
DB_POOL_MAX=10

# ---- MySQL / MariaDB (npm i mysql2) --------------------------------------
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_NAME=nestjs_base

# ---- MSSQL (npm i mssql) --------------------------------------------------
# DB_HOST=localhost
# DB_PORT=1433
# DB_USERNAME=sa
# DB_PASSWORD=YourStrong!Passw0rd
# DB_NAME=nestjs_base

# ---- Oracle (npm i oracledb) ----------------------------------------------
# DB_HOST=localhost
# DB_PORT=1521
# DB_USERNAME=app
# DB_PASSWORD=app
# ORACLE_SERVICE_NAME=FREEPDB1

# ---- SQLite (npm i sqlite3) -----------------------------------------------
# SQLITE_PATH=data/app.sqlite

# ---- MongoDB (npm i @nestjs/mongoose mongoose) ----------------------------
# MONGODB_URI=mongodb://root:root@localhost:27017/nestjs_base?authSource=admin

# =============================================================================
#  REDIS (tùy chọn — xem src/database/database.alternatives.ts)
# =============================================================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_MS=60000
