# ---------------------------------------------------------------
# Public variables (inlined into the client bundle at BUILD time)
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Next.js Base"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_API_TIMEOUT=15000

# ---------------------------------------------------------------
# Server-only variables (read at runtime)
# ---------------------------------------------------------------
# Optional internal URL used by Server Components (e.g. http://backend:8080/api in Docker/K8s).
# Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
